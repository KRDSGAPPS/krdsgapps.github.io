rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedEmail() && request.auth.token.email == 'shakirgoran@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedEmail() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAppItem(data) {
      return data.keys().hasAll([
          'slug', 'titleKu', 'titleEn', 'packageId', 'status', 'category',
          'summaryKu', 'summaryEn', 'playStoreUrl', 'githubUrl', 'iconUrl',
          'privacyPolicyEn', 'privacyPolicyKu', 'accountDeletionInfo',
          'dataCollected', 'version', 'sortOrder', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'slug', 'titleKu', 'titleEn', 'packageId', 'status', 'category',
          'summaryKu', 'summaryEn', 'playStoreUrl', 'githubUrl', 'iconUrl',
          'screenshots', 'privacyPolicyEn', 'privacyPolicyKu', 'accountDeletionInfo',
          'dataCollected', 'version', 'sortOrder', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && (!data.keys().hasAny(['screenshots']) || (data.screenshots is list && data.screenshots.size() <= 6))
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 80 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.titleKu is string && data.titleKu.size() >= 1 && data.titleKu.size() <= 120
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 120
        && data.packageId is string && data.packageId.size() <= 150
        && data.status is string && data.status in ['published', 'in_development', 'upcoming']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.summaryKu is string && data.summaryKu.size() <= 600
        && data.summaryEn is string && data.summaryEn.size() <= 600
        && data.playStoreUrl is string && data.playStoreUrl.size() <= 400
        && data.githubUrl is string && data.githubUrl.size() <= 400
        && data.iconUrl is string && data.iconUrl.size() <= 50000
        && data.privacyPolicyEn is string && data.privacyPolicyEn.size() <= 12000
        && data.privacyPolicyKu is string && data.privacyPolicyKu.size() <= 12000
        && data.accountDeletionInfo is string && data.accountDeletionInfo.size() <= 2000
        && data.dataCollected is string && data.dataCollected.size() <= 1000
        && data.version is string && data.version.size() <= 30
        && data.sortOrder is number
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDeveloperSettings(data) {
      return data.keys().hasAll([
          'brandNameKu', 'brandNameEn', 'heroTitleKu', 'heroTitleEn',
          'nameKu', 'nameEn', 'roleKu', 'roleEn', 'bioKu', 'bioEn',
          'locationKu', 'locationEn', 'email', 'playStoreDeveloperUrl',
          'githubProfileUrl', 'appAdsTxt', 'globalPrivacyPolicyEn',
          'globalPrivacyPolicyKu', 'ownerUid', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'brandNameKu', 'brandNameEn', 'heroTitleKu', 'heroTitleEn',
          'nameKu', 'nameEn', 'roleKu', 'roleEn', 'bioKu', 'bioEn',
          'locationKu', 'locationEn', 'email', 'playStoreDeveloperUrl',
          'githubProfileUrl', 'appAdsTxt', 'globalPrivacyPolicyEn',
          'globalPrivacyPolicyKu', 'ownerUid', 'updatedAt'
        ])
        && data.brandNameKu is string && data.brandNameKu.size() >= 1 && data.brandNameKu.size() <= 80
        && data.brandNameEn is string && data.brandNameEn.size() >= 1 && data.brandNameEn.size() <= 80
        && data.heroTitleKu is string && data.heroTitleKu.size() >= 1 && data.heroTitleKu.size() <= 160
        && data.heroTitleEn is string && data.heroTitleEn.size() >= 1 && data.heroTitleEn.size() <= 160
        && data.nameKu is string && data.nameKu.size() >= 1 && data.nameKu.size() <= 120
        && data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 120
        && data.roleKu is string && data.roleKu.size() <= 160
        && data.roleEn is string && data.roleEn.size() <= 160
        && data.bioKu is string && data.bioKu.size() <= 1200
        && data.bioEn is string && data.bioEn.size() <= 1200
        && data.locationKu is string && data.locationKu.size() <= 160
        && data.locationEn is string && data.locationEn.size() <= 160
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.playStoreDeveloperUrl is string && data.playStoreDeveloperUrl.size() <= 400
        && data.githubProfileUrl is string && data.githubProfileUrl.size() <= 400
        && data.appAdsTxt is string && data.appAdsTxt.size() <= 4000
        && data.globalPrivacyPolicyEn is string && data.globalPrivacyPolicyEn.size() <= 15000
        && data.globalPrivacyPolicyKu is string && data.globalPrivacyPolicyKu.size() <= 15000
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.updatedAt is timestamp;
    }

    match /apps/{appId} {
      allow get: if isValidId(appId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(appId)
        && isValidAppItem(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(appId)
        && isValidAppItem(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'titleKu', 'titleEn', 'packageId', 'status', 'category',
          'summaryKu', 'summaryEn', 'playStoreUrl', 'githubUrl', 'iconUrl',
          'screenshots', 'privacyPolicyEn', 'privacyPolicyKu', 'accountDeletionInfo',
          'dataCollected', 'version', 'sortOrder', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(appId);
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidDeveloperSettings(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidDeveloperSettings(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'brandNameKu', 'brandNameEn', 'heroTitleKu', 'heroTitleEn',
          'nameKu', 'nameEn', 'roleKu', 'roleEn', 'bioKu', 'bioEn',
          'locationKu', 'locationEn', 'email', 'playStoreDeveloperUrl',
          'githubProfileUrl', 'appAdsTxt', 'globalPrivacyPolicyEn',
          'globalPrivacyPolicyKu', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(settingId);
    }

    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create, update, delete: if isBootstrappedAdmin() && isValidId(uid);
    }

    function isValidProjectRequest(data) {
      return data.keys().hasAll([
          'clientName', 'contactInfo', 'platform', 'projectTitle',
          'message', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'clientName', 'contactInfo', 'platform', 'projectTitle',
          'message', 'status', 'createdAt'
        ])
        && data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100
        && data.contactInfo is string && data.contactInfo.size() >= 3 && data.contactInfo.size() <= 160
        && data.platform is string && data.platform in ['android', 'desktop', 'both']
        && data.projectTitle is string && data.projectTitle.size() >= 2 && data.projectTitle.size() <= 120
        && data.message is string && data.message.size() >= 10 && data.message.size() <= 2000
        && data.status == 'new'
        && data.createdAt == request.time;
    }

    match /requests/{requestId} {
      allow create: if isValidId(requestId) && isValidProjectRequest(incoming());
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && isValidId(requestId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && incoming().status in ['new', 'reviewed', 'done'];
      allow delete: if isAdmin() && isValidId(requestId);
    }
  }
}
