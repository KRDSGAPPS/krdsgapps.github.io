{
  "entities": {
    "AppItem": {
      "title": "AppItem",
      "description": "An Android or web application published or in development by the developer, including Google Play Console metadata and privacy policy.",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9\\-]+$",
          "minLength": 2,
          "maxLength": 80,
          "description": "URL-safe identifier used for per-app Privacy Policy links."
        },
        "titleKu": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "titleEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "packageId": {
          "type": "string",
          "maxLength": 150
        },
        "status": {
          "type": "string",
          "enum": ["published", "in_development", "upcoming"]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "summaryKu": {
          "type": "string",
          "maxLength": 600
        },
        "summaryEn": {
          "type": "string",
          "maxLength": 600
        },
        "playStoreUrl": {
          "type": "string",
          "maxLength": 400
        },
        "githubUrl": {
          "type": "string",
          "maxLength": 400
        },
        "iconUrl": {
          "type": "string",
          "maxLength": 50000
        },
        "screenshots": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          }
        },
        "privacyPolicyEn": {
          "type": "string",
          "maxLength": 12000
        },
        "privacyPolicyKu": {
          "type": "string",
          "maxLength": 12000
        },
        "accountDeletionInfo": {
          "type": "string",
          "maxLength": 2000
        },
        "dataCollected": {
          "type": "string",
          "maxLength": 1000
        },
        "version": {
          "type": "string",
          "maxLength": 30
        },
        "sortOrder": {
          "type": "number"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slug",
        "titleKu",
        "titleEn",
        "packageId",
        "status",
        "category",
        "summaryKu",
        "summaryEn",
        "playStoreUrl",
        "githubUrl",
        "iconUrl",
        "privacyPolicyEn",
        "privacyPolicyKu",
        "accountDeletionInfo",
        "dataCollected",
        "version",
        "sortOrder",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "DeveloperSettings": {
      "title": "DeveloperSettings",
      "description": "Public studio brand, hero headlines, developer profile, Play Console configuration, and default privacy policy.",
      "type": "object",
      "properties": {
        "brandNameKu": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "brandNameEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "heroTitleKu": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "heroTitleEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "nameKu": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "nameEn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "roleKu": {
          "type": "string",
          "maxLength": 160
        },
        "roleEn": {
          "type": "string",
          "maxLength": 160
        },
        "bioKu": {
          "type": "string",
          "maxLength": 1200
        },
        "bioEn": {
          "type": "string",
          "maxLength": 1200
        },
        "locationKu": {
          "type": "string",
          "maxLength": 160
        },
        "locationEn": {
          "type": "string",
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "playStoreDeveloperUrl": {
          "type": "string",
          "maxLength": 400
        },
        "githubProfileUrl": {
          "type": "string",
          "maxLength": 400
        },
        "appAdsTxt": {
          "type": "string",
          "maxLength": 4000
        },
        "globalPrivacyPolicyEn": {
          "type": "string",
          "maxLength": 15000
        },
        "globalPrivacyPolicyKu": {
          "type": "string",
          "maxLength": 15000
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "brandNameKu",
        "brandNameEn",
        "heroTitleKu",
        "heroTitleEn",
        "nameKu",
        "nameEn",
        "roleKu",
        "roleEn",
        "bioKu",
        "bioEn",
        "locationKu",
        "locationEn",
        "email",
        "playStoreDeveloperUrl",
        "githubProfileUrl",
        "appAdsTxt",
        "globalPrivacyPolicyEn",
        "globalPrivacyPolicyKu",
        "ownerUid",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/apps/{appId}": {
      "schema": { "$ref": "#/entities/AppItem" },
      "description": "Publicly readable catalog of developer apps; writable only by verified admin."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/DeveloperSettings" },
      "description": "Publicly readable developer profile and Play Console configuration; writable only by verified admin."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin authorization registry; private to the authenticated admin."
    }
  }
}
